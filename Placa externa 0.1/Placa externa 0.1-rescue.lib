EESchema-LIBRARY Version 2.4
#encoding utf-8
#
# BMP280...-Sensor_Pressure1
#
DEF BMP280...-Sensor_Pressure1 U 0 20 Y Y 1 F N
F0 "U" -300 400 50 H V L TNN
F1 "BMP280...-Sensor_Pressure1" 200 400 50 H V L TNN
F2 "Package_LGA:Bosch_LGA-8_2x2.5mm_P0.65mm_ClockwisePinNumbering" 0 -700 50 H I C CNN
F3 "" 0 0 50 H I C CNN
$FPLIST
 Bosch*LGA*2x2.5mm*P0.65mm*
$ENDFPLIST
DRAW
S -300 -200 200 300 0 1 10 f
X VDD 1 100 400 100 D 50 50 1 1 W
X GND 2 100 -300 100 U 50 50 1 1 W
X SCL 3 -400 100 100 R 50 50 1 1 B
X SDA 4 -400 200 100 R 50 50 1 1 I
X NET-PAD5 5 -400 0 100 R 50 50 1 1 B
X NET-PAD6 6 -400 -100 100 R 50 50 1 1 I
ENDDRAW
ENDDEF
#
# HC-05-New_Library
#
DEF HC-05-New_Library U 0 40 Y Y 1 F N
F0 "U" -50 -350 50 H V L CNN
F1 "HC-05-New_Library" -150 350 50 H V L CNN
F2 "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm" 100 -900 50 H I C CIN
F3 "" 0 50 50 H I C CNN
$FPLIST
 SOIC*3.9x4.9mm*P1.27mm*
$ENDFPLIST
DRAW
S -250 300 250 -300 0 1 10 f
X EN 1 350 250 100 L 50 50 1 1 I
X VCC 2 350 0 100 L 50 50 1 1 W
X GND 3 350 -250 100 L 50 50 1 1 W
X TX 4 -350 -250 100 R 50 50 1 1 O
X RX 5 -350 -100 100 R 50 50 1 1 I
X STATE 6 -350 250 100 R 50 50 1 1 I
ENDDRAW
ENDDEF
#
# LM393IR-New_Library
#
DEF LM393IR-New_Library U 0 40 Y Y 1 F N
F0 "U" 0 -250 50 H V C CNN
F1 "LM393IR-New_Library" 0 250 50 H V C CNN
F2 "" 0 -250 50 H I C CNN
F3 "" 0 -250 50 H I C CNN
DRAW
S -200 200 200 -200 0 1 0 N
X VCC 1 -300 100 100 R 50 50 1 1 W
X GND 2 -300 0 100 R 50 50 1 1 W
X OUT 3 -300 -100 100 R 50 50 1 1 O
ENDDRAW
ENDDEF
