#encoding utf-8
#
# MPU-9250-MPU
#
DEF MPU-9250-MPU U 0 20 Y Y 1 F N
F0 "U" -450 750 50 H V C CNN
F1 "MPU-9250-MPU" 300 -750 50 H V C CNN
F2 "Sensor_Motion:InvenSense_QFN-24_3x3mm_P0.4mm" 0 -900 50 H I C CNN
F3 "" -150 950 50 H I C CNN
$FPLIST
 *QFN*3x3mm*P0.4mm*
$ENDFPLIST
DRAW
S -500 700 500 -700 0 1 10 f
X VCC 1 600 550 100 L 50 50 1 1 W
X Fsync 10 600 -600 100 L 50 50 1 1 I
X GND 2 600 400 100 L 50 50 1 1 W
X SCL 3 600 250 100 L 50 50 1 1 I
X SDA 4 600 100 100 L 50 50 1 1 I
X EDA 5 600 -100 100 L 50 50 1 1 I
X ECL 6 600 -200 100 L 50 50 1 1 I
X ADO 7 600 -300 100 L 50 50 1 1 I
X INT 8 600 -400 100 L 50 50 1 1 I
X NCS 9 600 -500 100 L 50 50 1 1 I
ENDDRAW
ENDDEF
#
#End Library
